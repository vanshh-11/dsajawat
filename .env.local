# D SAJAWAT Portfolio - Environment Variables
# Copy this to .env.local and fill in your values
# DO NOT COMMIT THIS FILE TO GIT

# ===========================================
# SUPABASE (Database + Auth + Storage)
# ===========================================
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # Server-only! Keep secret
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...         # Client-safe

# ===========================================
# RESEND (Email)
# ===========================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_123456789...
# Use Resend's free shared domain for now
RESEND_FROM_EMAIL=D SAJAWAT <onboarding@resend.dev>
RESEND_ADMIN_EMAIL=dsajawat@gmail.com

# ===========================================
# ADMIN (Simple password auth for /admin)
# ===========================================
# Generate a secure password: openssl rand -base64 32
ADMIN_PASSWORD=your-secure-admin-password-here
ADMIN_URL=https://your-vercel-domain.vercel.app/admin

# ===========================================
# OPTIONAL: Upstash Redis (Rate limiting - add later)
# ===========================================
# Get from: https://console.upstash.com/redis
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# ===========================================
# OPTIONAL: Cloudinary (Images - Phase 3, use Supabase Storage instead)
# ===========================================
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...